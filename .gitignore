# Runtime data — never commit. secret.key is the pepper behind every issued
# API key; blobs/ and thumbs/ are clients' screenshots.
secret.key
*.db
*.db-wal
*.db-shm
blobs/
thumbs/

# Filled-in deployment files carry real hostnames and live on the server.
# The .example templates are tracked.
deploy/otk.env
deploy/Caddyfile
deploy/nginx.conf
