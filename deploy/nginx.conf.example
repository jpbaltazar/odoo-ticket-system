# nginx alternative to the Caddyfile. Certificates via certbot --nginx.
#
# THE ONE THAT BITES: nginx defaults client_max_body_size to 1 MB. Left alone,
# every screenshot upload fails with a 413 that never reaches the application,
# so `otk inspect` shows nothing and the Odoo module looks broken. The
# directive below is not optional.

server {
    listen 80;
    listen [::]:80;
    server_name tickets.example.com admin.example.com;
    # Keep this for ACME renewal; everything else goes to TLS.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# --- client-facing intake API -----------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name tickets.example.com;

    ssl_certificate     /etc/letsencrypt/live/tickets.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tickets.example.com/privkey.pem;

    client_max_body_size 40m;   # >= OTK_MAX_BODY_MB

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # Without this the session cookie never gets its Secure flag.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

# --- operator UI ------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name admin.example.com;

    ssl_certificate     /etc/letsencrypt/live/admin.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.example.com/privkey.pem;

    client_max_body_size 40m;

    # Uncomment to keep the operator UI off the open internet entirely.
    # allow 203.0.113.4;
    # allow 10.0.0.0/8;
    # deny all;

    location / {
        proxy_pass http://127.0.0.1:8788;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
