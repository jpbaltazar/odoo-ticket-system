# Copy to /etc/odoo-tickets/env, then: chown root:otk, chmod 640
#
# OTK_SECRET is deliberately NOT set here. Left unset, the server generates
# $OTK_DATA_DIR/secret.key (mode 0600) on first run. Setting it in this file
# means the pepper for every API key sits in an extra place to leak.

OTK_DATA_DIR=/var/lib/odoo-tickets

# Both bind to loopback; the reverse proxy is the only thing that reaches them.
# Setting this to 0.0.0.0 puts the operator UI on the internet with no TLS.
OTK_HOST=127.0.0.1
OTK_PORT=8787
OTK_WEB_PORT=8788

# Your zone, not the server's. A Hetzner box runs UTC (or CET); rendering
# timestamps in it would show you every time an hour off, year round.
OTK_TZ=Europe/Lisbon

# Origins allowed to POST browser-direct uploads. Narrow this to your clients'
# Odoo domains once you know them; "*" is the permissive default.
# OTK_CORS_ORIGINS=https://acme.odoo.example,https://globex.odoo.example

# Automatic retention. 0 = off. See deploy/README.md for the timer.
OTK_RETENTION_DAYS=0

# Defaults shown for reference; uncomment only to change.
# OTK_MAX_FILE_MB=10
# OTK_MAX_TICKET_MB=25
# OTK_MAX_BODY_MB=36
# OTK_RATE_LIMIT=120

# --- alerts -----------------------------------------------------------------
# ntfy topic. Empty disables notifications entirely.
# Use your own instance or an authenticated topic: an unprotected topic name on
# a public server is guessable, and these alerts name your clients.
# OTK_NOTIFY_URL=https://ntfy.sh/your-long-unguessable-topic
# OTK_NOTIFY_TOKEN=tk_...

# Deployment-wide threshold. Per-client overrides: otk client notify <slug> <level>
# OTK_NOTIFY_MIN_PRIORITY=high

# Set to 0 to push only the reference and client, not the ticket title. The
# title is written by someone else's employee and can name a customer.
# OTK_NOTIFY_INCLUDE_TITLE=1

# Makes alerts tappable — the push links straight to the ticket.
# OTK_WEB_BASE_URL=https://admin.abansec.com

# --- MCP endpoint (only if serving it over HTTP for claude.ai) --------------
# Public URL this is served at. Required for --http: it is advertised in the
# auth metadata, and a mismatch lets a token issued for one host be replayed
# against another.
# OTK_MCP_URL=https://mcp.abansec.com
# OTK_MCP_PORT=8789
